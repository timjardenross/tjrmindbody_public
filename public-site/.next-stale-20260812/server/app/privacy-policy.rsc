2:[["$","p",null,{"children":"This page explains, in simple language, how TJR Mind & Body may collect, use, store, and manage personal information shared through the website or by email."}],"\n",["$","p",null,{"children":"TJR Mind & Body operates under ABN 13 243 445 248."}],"\n",["$","h2",null,{"id":"what-information-may-be-collected","children":["$","a",null,{"href":"#what-information-may-be-collected","children":"What information may be collected"}]}],"\n",["$","p",null,{"children":"TJR Mind & Body may collect personal information that you choose to provide, such as your name, email address, and the contents of messages you send through contact forms or direct email."}],"\n",["$","p",null,{"children":"Basic website usage information may also be collected automatically, such as browser type, device information, and page visits, to help understand how the site is being used."}],"\n",["$","h2",null,{"id":"how-information-may-be-used","children":["$","a",null,{"href":"#how-information-may-be-used","children":"How information may be used"}]}],"\n",["$","p",null,{"children":"Information may be used to respond to enquiries, provide support, communicate about coaching or education services, improve the website, and keep basic records of communications."}],"\n",["$","p",null,{"children":"TJR Mind & Body is positioned as a coaching and education brand focused on practical resilience, support, self-management, and rebuilding. Personal information is not collected for clinical or treatment purposes through this site."}],"\n",["$","h2",null,{"id":"storage-and-security","children":["$","a",null,{"href":"#storage-and-security","children":"Storage and security"}]}],"\n",["$","p",null,{"children":"Reasonable steps are taken to protect personal information from misuse, loss, unauthorised access, modification, or disclosure. No online system can guarantee absolute security, but information is handled carefully and only kept for as long as reasonably needed."}],"\n",["$","h2",null,{"id":"third-party-services","children":["$","a",null,{"href":"#third-party-services","children":"Third-party services"}]}],"\n",["$","p",null,{"children":"The site may use third-party tools such as website hosting, analytics, email services, or form tools. Those providers may handle information according to their own privacy practices."}],"\n",["$","h2",null,{"id":"access-corrections-and-contact","children":["$","a",null,{"href":"#access-corrections-and-contact","children":"Access, corrections, and contact"}]}],"\n",["$","p",null,{"children":["If you would like to request access to personal information you have shared, ask for a correction, or make a privacy enquiry, contact ",["$","a",null,{"href":"mailto:support@tjrmindbody.com","children":"support@tjrmindbody.com"}],"."]}],"\n",["$","h2",null,{"id":"updates","children":["$","a",null,{"href":"#updates","children":"Updates"}]}],"\n",["$","p",null,{"children":"This policy may be updated from time to time as the website or business practices change. The latest version always appears on this page."}]]
