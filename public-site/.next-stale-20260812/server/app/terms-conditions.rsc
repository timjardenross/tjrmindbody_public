2:[["$","p",null,{"children":"These terms describe the general basis on which people use the TJR Mind & Body website and content."}],"\n",["$","p",null,{"children":"TJR Mind & Body operates under ABN 13 243 445 248."}],"\n",["$","h2",null,{"id":"purpose-of-the-website","children":["$","a",null,{"href":"#purpose-of-the-website","children":"Purpose of the website"}]}],"\n",["$","p",null,{"children":"TJR Mind & Body is a practical resilience coaching and education brand. The website is intended to share information about support, coaching, education, practical resilience, self-management, and rebuilding."}],"\n",["$","h2",null,{"id":"general-information-only","children":["$","a",null,{"href":"#general-information-only","children":"General information only"}]}],"\n",["$","p",null,{"children":"Content on this site is provided for general information and education purposes. It is not presented as treatment, cure, clinical guidance, therapy, or medical advice."}],"\n",["$","h2",null,{"id":"using-the-site","children":["$","a",null,{"href":"#using-the-site","children":"Using the site"}]}],"\n",["$","p",null,{"children":"By using the site, you agree to use it lawfully and respectfully. You should not misuse the site, interfere with its operation, or use its content in misleading or deceptive ways."}],"\n",["$","h2",null,{"id":"intellectual-property","children":["$","a",null,{"href":"#intellectual-property","children":"Intellectual property"}]}],"\n",["$","p",null,{"children":"Unless otherwise stated, the content, copy, branding, and visual materials on this site belong to TJR Mind & Body. You may view and share the site for personal, non-misleading purposes, but you should not reproduce or republish material as your own without permission."}],"\n",["$","h2",null,{"id":"links-and-third-party-tools","children":["$","a",null,{"href":"#links-and-third-party-tools","children":"Links and third-party tools"}]}],"\n",["$","p",null,{"children":"The website may contain links to third-party websites or use third-party services. TJR Mind & Body is not responsible for the content, availability, or privacy practices of those external services."}],"\n",["$","h2",null,{"id":"liability","children":["$","a",null,{"href":"#liability","children":"Liability"}]}],"\n",["$","p",null,{"children":"Reasonable care is taken to keep website information clear and current, but no guarantee is made that the site will always be complete, accurate, or uninterrupted. To the extent permitted by law, liability for loss arising from use of the website is limited."}],"\n",["$","h2",null,{"id":"contact","children":["$","a",null,{"href":"#contact","children":"Contact"}]}],"\n",["$","p",null,{"children":["If you have questions about these terms, contact ",["$","a",null,{"href":"mailto:support@tjrmindbody.com","children":"support@tjrmindbody.com"}],"."]}]]
