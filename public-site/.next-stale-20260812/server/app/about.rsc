2:[["$","h2",null,{"id":"why-tjr-mind--body-exists","children":["$","a",null,{"href":"#why-tjr-mind--body-exists","children":"Why TJR Mind & Body exists"}]}],"\n",["$","p",null,{"children":"TJR Mind & Body operates under ABN 13 243 445 248."}],"\n",["$","p",null,{"children":"This is a place for people who have been carrying a lot for a long time and are ready for something gentler, clearer, and more sustainable."}],"\n",["$","p",null,{"children":"The work here sits at the meeting point of professional resilience and lived resilience."}],"\n",["$","p",null,{"children":"For more than 15 years, I have worked in operational resilience, business continuity, crisis management, and major incident response across some of Australia's most complex organisations."}],"\n",["$","p",null,{"children":"My job has been to help people and organisations prepare for uncertainty, respond under pressure, and recover when things do not go to plan."}],"\n",["$","p",null,{"children":"At its core, resilience has always been about protecting what matters most and helping people keep moving through difficult circumstances."}],"\n",["$","blockquote",null,{"children":["\n",["$","p",null,{"children":"I've spent my career helping organisations become more resilient. Now my mission is to help people do the same, one practical step at a time."}],"\n"]}],"\n",["$","p",null,{"children":"At the same time, I have been living a very different resilience story."}],"\n",["$","p",null,{"children":"For more than 20 years, I have lived with chronic spinal pain, multiple surgeries, anxiety, depression, burnout, and the ongoing challenge of rebuilding my health while continuing to navigate everyday life and a demanding career."}],"\n",["$","p",null,{"children":"Those experiences changed how I think about resilience."}],"\n",["$","p",null,{"children":"I learned that resilience is not about pushing harder, ignoring pain, or simply \"being stronger.\""}],"\n",["$","p",null,{"children":"It is about understanding your capacity, recognising your limits without being defined by them, and building practical systems that help you adapt when life changes."}],"\n",["$","p",null,{"children":"There was never a single breakthrough."}],"\n",["$","p",null,{"children":"There was no miracle treatment or overnight transformation."}],"\n",["$","p",null,{"children":"Instead, progress came through thousands of small decisions: learning what helped, letting go of what didn't, rebuilding after setbacks, and accepting that recovery is rarely a straight line."}],"\n",["$","p",null,{"children":"That journey became the foundation of TJR Mind & Body."}],"\n",["$","p",null,{"children":"This is where professional resilience meets human resilience."}],"\n",["$","p",null,{"children":"It combines evidence-informed thinking, practical coaching, lived experience, and systems thinking to help people navigate real life, not the perfect version of it."}],"\n",["$","p",null,{"children":"I am not a doctor or therapist, and this site does not offer diagnosis or treatment. What I do offer is practical coaching and education grounded in lived and professional experience."}],"\n",["$","p",null,{"children":"Because resilience isn't something reserved for disasters."}],"\n",["$","p",null,{"children":"It's something we need every day."}],"\n",["$","hr",null,{}],"\n",["$","h2",null,{"id":"who-this-is-for","children":["$","a",null,{"href":"#who-this-is-for","children":"Who this is for"}]}],"\n",["$","p",null,{"children":"TJR Mind & Body is for people who feel like life has become heavier than it used to be."}],"\n",["$","p",null,{"children":"You might be living with chronic pain, burnout, anxiety, overwhelming stress, neurodivergence, major life changes, or simply the quiet exhaustion that comes from trying to keep everything together while your capacity continues to shrink."}],"\n",["$","p",null,{"children":"You do not need to be at rock bottom."}],"\n",["$","p",null,{"children":"You simply need a place to start rebuilding."}],"\n",["$","p",null,{"children":"This is not about becoming the most productive version of yourself."}],"\n",["$","p",null,{"children":"It is about creating a life that is sustainable, meaningful, and resilient enough to handle whatever comes next."}],"\n",["$","hr",null,{}],"\n",["$","h2",null,{"id":"what-makes-this-different","children":["$","a",null,{"href":"#what-makes-this-different","children":"What makes this different"}]}],"\n",["$","p",null,{"children":"Most resilience advice assumes everyone has the same amount of energy, time, and capacity."}],"\n",["$","p",null,{"children":"Real life does not work that way."}],"\n",["$","p",null,{"children":"Your capacity changes from day to day. Health changes. Work changes. Family changes. Unexpected events happen."}],"\n",["$","p",null,{"children":"Instead of fighting that reality, TJR Mind & Body helps you work with it."}],"\n",["$","p",null,{"children":"Everything is built around practical strategies that help you:"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":"Understand your current capacity."}],"\n",["$","li",null,{"children":"Reduce unnecessary pressure."}],"\n",["$","li",null,{"children":"Build habits that are sustainable."}],"\n",["$","li",null,{"children":"Recover more effectively."}],"\n",["$","li",null,{"children":"Make better decisions during difficult periods."}],"\n",["$","li",null,{"children":"Create personal systems that continue working when life becomes challenging."}],"\n"]}],"\n",["$","p",null,{"children":"The goal is not perfection."}],"\n",["$","p",null,{"children":"The goal is helping you continue moving forward, even when life does not go according to plan."}],"\n",["$","hr",null,{}],"\n",["$","h2",null,{"id":"what-shapes-the-approach","children":["$","a",null,{"href":"#what-shapes-the-approach","children":"What shapes the approach"}]}],"\n",["$","p",null,{"children":"The work draws from four connected perspectives:"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Operational resilience"}],": understanding how people and systems prepare for, respond to, and recover from disruption."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Lived experience"}],": more than two decades navigating chronic pain, mental health challenges, recovery, and rebuilding."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Evidence-informed coaching"}],": translating research into practical tools that work in everyday life."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Systems thinking"}],": recognising that lasting change comes from improving the environment, routines, and decisions around you, not simply relying on willpower."]}],"\n"]}],"\n",["$","hr",null,{}],"\n",["$","h2",null,{"id":"a-simple-belief","children":["$","a",null,{"href":"#a-simple-belief","children":"A simple belief"}]}],"\n",["$","p",null,{"children":"You do not need to become someone else to build resilience."}],"\n",["$","p",null,{"children":"You need to better understand your capacity, work with it instead of against it, and build systems that support the life you want to live."}],"\n",["$","p",null,{"children":"That is what TJR Mind & Body is here to help you do."}]]
